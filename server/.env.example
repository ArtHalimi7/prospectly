# ==========================================
# Prospectly Server Environment Variables
# ==========================================

# Server Port
PORT=5000

# Database Configuration (Optional - falls back to local storage if offline)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=prospectly

# Google Gemini AI API Key (Required for AI Enrichment & Pitch Drafting)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Gmail / Google Workspace SMTP (For Automated Outreach Campaigns)
# Generate an App Password in your Google Account Security settings
GMAIL_USER=
GMAIL_PASS=

# Throttle Delay (Seconds) between outbound emails to protect sender score
SMTP_DELAY=30
